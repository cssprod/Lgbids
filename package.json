{
  "name": "lgbids",
  "version": "0.1.0",
  "private": true,
  "description": "Finds, qualifies and applies to gardening and landscaping bid opportunities in Greater Victoria, BC.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-sources": "tsx src/server/cli/checkSources.ts",
    "run-once": "tsx src/server/cli/runOnce.ts",
    "demo": "tsx src/server/cli/demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.11",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "domhandler": "^5.0.3",
    "fastify": "^5.12.8",
    "luxon": "^3.7.2",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "mailparser": "^3.14.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "smtp-server": "^3.21.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
